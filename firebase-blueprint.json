{
  "entities": {
    "User": {
      "title": "User",
      "description": "Community member profile, free vs premium membership status, field-level visibility settings, education, experience, certifications, projects, and CV vault",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "profilePhotoUrl": { "type": "string", "maxLength": 350000 },
        "profilePicUrl": { "type": "string", "maxLength": 350000 },
        "qualification": { "type": "string", "maxLength": 300 },
        "experience": { "type": "array" },
        "experienceItems": { "type": "array" },
        "education": { "type": "array" },
        "certifications": { "type": "array" },
        "projects": { "type": "array" },
        "currentRole": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 120 },
        "bio": { "type": "string", "maxLength": 2000 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 60 },
        "linkedinUrl": { "type": "string", "maxLength": 500 },
        "portfolioUrl": { "type": "string", "maxLength": 500 },
        "skills": { "type": "array" },
        "specializations": { "type": "array" },
        "cvUrl": { "type": "string", "maxLength": 750000 },
        "cvFileName": { "type": "string", "maxLength": 260 },
        "cvFileSize": { "type": "string", "maxLength": 60 },
        "cvUploadedAt": { "type": "string", "maxLength": 64 },
        "hireMe": { "type": "boolean" },
        "plan": { "type": "string", "enum": ["free", "premium"] },
        "isPremium": { "type": "boolean" },
        "profileCompleted": { "type": "boolean" },
        "profileVisibility": { "type": "boolean" },
        "visibility": { "type": "object" },
        "privacySettings": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "isAdmin": { "type": "boolean" },
        "isPaid": { "type": "boolean" },
        "paymentStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "paymentAmount": { "type": "string", "maxLength": 80 },
        "receiptImageUrl": { "type": "string", "maxLength": 450000 },
        "subscriptionPlan": { "type": "string", "maxLength": 80 },
        "premiumActivatedAt": { "type": "string", "maxLength": 64 },
        "premiumExpiresAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "name"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Paid membership and payment verification request sent by a user to Admin Control Panel with payment receipt image",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userPhone": { "type": "string", "maxLength": 60 },
        "qualification": { "type": "string", "maxLength": 300 },
        "currentRole": { "type": "string", "maxLength": 200 },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "transactionId": { "type": "string", "maxLength": 120 },
        "amount": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 1000 },
        "receiptImageUrl": { "type": "string", "maxLength": 450000 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "subscriptionPlan": { "type": "string", "maxLength": 80 },
        "approvedAt": { "type": "string", "maxLength": 64 },
        "premiumExpiresAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "uid", "userName", "paymentMethod", "transactionId", "status"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued Training Certificates for Highfield and Lead Auditor courses stored for individual verification and download",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "certificateNumber": { "type": "string", "maxLength": 120 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 160 },
        "recipientEmail": { "type": "string", "maxLength": 200 },
        "trainingCategory": { "type": "string", "maxLength": 120 },
        "trainingTitle": { "type": "string", "maxLength": 240 },
        "accreditationBody": { "type": "string", "maxLength": 160 },
        "issueDate": { "type": "string", "maxLength": 64 },
        "certificateImageUrl": { "type": "string", "maxLength": 550000 },
        "verificationStatus": { "type": "string", "enum": ["valid", "revoked"] },
        "issuedBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "certificateNumber", "recipientName", "trainingTitle", "issueDate", "verificationStatus"]
    },
    "CloudStorageConfig": {
      "title": "CloudStorageConfig",
      "description": "Global cloud media storage configuration (Smart Firestore Compression + Free Cloudinary CDN)",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "enum": ["smart-firestore", "cloudinary"] },
        "cloudinaryCloudName": { "type": "string", "maxLength": 120 },
        "cloudinaryUploadPreset": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["provider"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "User-to-Admin support chat and member hiring inquiry messages visible in Admin Backend",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderPhone": { "type": "string", "maxLength": 60 },
        "recipientName": { "type": "string", "maxLength": 120 },
        "chatType": { "type": "string", "enum": ["admin_support", "hiring_contact"] },
        "message": { "type": "string", "maxLength": 2000 },
        "adminReply": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "senderName", "recipientName", "chatType", "message"]
    },
    "Job": {
      "title": "Job",
      "description": "Food Safety, Quality, R&D Lab, Dairy, Bakery, Nutrition, and Production job listings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "company": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "country": { "type": "string", "maxLength": 120 },
        "specialization": { "type": "string", "maxLength": 120 },
        "experienceRequired": { "type": "string", "maxLength": 120 },
        "category": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 8000 },
        "requirements": { "type": "string", "maxLength": 8000 },
        "hrEmail": { "type": "string", "maxLength": 200 },
        "emailSubject": { "type": "string", "maxLength": 300 },
        "applicationGuidelines": { "type": "string", "maxLength": 2000 },
        "applyLink": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array" },
        "postedAt": { "type": "string", "maxLength": 64 },
        "expiryAt": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "company", "category", "isActive"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Food Science & Technology scholarships, fellowships, and grants",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "organization": { "type": "string", "maxLength": 240 },
        "country": { "type": "string", "maxLength": 120 },
        "specialization": { "type": "string", "maxLength": 120 },
        "deadline": { "type": "string", "maxLength": 64 },
        "fundingType": { "type": "string", "maxLength": 120 },
        "degreeLevel": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 8000 },
        "eligibility": { "type": "string", "maxLength": 8000 },
        "hrEmail": { "type": "string", "maxLength": 200 },
        "emailSubject": { "type": "string", "maxLength": 300 },
        "applicationGuidelines": { "type": "string", "maxLength": 2000 },
        "applyLink": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" }
      },
      "required": ["title", "organization", "country", "isActive"]
    },
    "Training": {
      "title": "Training",
      "description": "Highfield and Lead Auditor training programs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 200 },
        "standardCode": { "type": "string", "maxLength": 80 },
        "subType": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 8000 },
        "duration": { "type": "string", "maxLength": 120 },
        "fees": { "type": "string", "maxLength": 120 },
        "enrollLink": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" }
      },
      "required": ["category", "title", "isActive"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Free and Premium (Paid) user records with payment verification state and sanitized public fields"
    },
    "/users/{uid}/private/{docId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Strictly private per-user profile vault accessible only by the owner (request.auth.uid == uid) or admin"
    },
    "/users/{uid}/profile/{docId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document subcollection"
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Membership payment verification requests and receipt images submitted to Admin Control Panel"
    },
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Issued Training Certificates for Highfield and Lead Auditor trainings"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CloudStorageConfig" },
      "description": "Cloud media storage & CDN configuration"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Support chats and member hiring messages visible in Admin Control Panel"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Food Science & Technology job openings"
    },
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "#/entities/Scholarship" },
      "description": "Food Science & Technology scholarships and fellowships"
    },
    "/trainings/{trainingId}": {
      "schema": { "$ref": "#/entities/Training" },
      "description": "Highfield and Lead Auditor training programs"
    }
  }
}

