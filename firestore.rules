rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow get: if true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPrivacySettings(ps) {
      return ps is map &&
        ps.keys().hasAll([
          'qualification_public',
          'experience_public',
          'currentRole_public',
          'location_public',
          'email_public',
          'phone_public'
        ]) &&
        ps.qualification_public is bool &&
        ps.experience_public is bool &&
        ps.currentRole_public is bool &&
        ps.location_public is bool &&
        ps.email_public is bool &&
        ps.phone_public is bool &&
        (!('hireMe_public' in ps) || ps.hireMe_public is bool);
    }

    function isValidVisibilityMap(vis) {
      return vis is map;
    }

    function isValidUser(data, uid) {
      return data is map &&
        data.keys().hasAll(['uid', 'name']) &&
        data.uid == uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 350000)) &&
        (!('profilePicUrl' in data) || (data.profilePicUrl is string && data.profilePicUrl.size() <= 350000)) &&
        (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 300)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 5000) || (data.experience is list && data.experience.size() <= 50)) &&
        (!('experienceItems' in data) || (data.experienceItems is list && data.experienceItems.size() <= 50)) &&
        (!('education' in data) || (data.education is list && data.education.size() <= 50)) &&
        (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 50)) &&
        (!('projects' in data) || (data.projects is list && data.projects.size() <= 50)) &&
        (!('currentRole' in data) || (data.currentRole is string && data.currentRole.size() <= 200)) &&
        (!('company' in data) || (data.company is string && data.company.size() <= 200)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 120)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 60)) &&
        (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 500)) &&
        (!('portfolioUrl' in data) || (data.portfolioUrl is string && data.portfolioUrl.size() <= 500)) &&
        (!('skills' in data) || (data.skills is list && data.skills.size() <= 30)) &&
        (!('specializations' in data) || (data.specializations is list && data.specializations.size() <= 30)) &&
        (!('cvUrl' in data) || (data.cvUrl is string && data.cvUrl.size() <= 750000)) &&
        (!('cvFileName' in data) || (data.cvFileName is string && data.cvFileName.size() <= 260)) &&
        (!('cvFileSize' in data) || (data.cvFileSize is string && data.cvFileSize.size() <= 60)) &&
        (!('cvUploadedAt' in data) || (data.cvUploadedAt is string && data.cvUploadedAt.size() <= 64)) &&
        (!('hireMe' in data) || data.hireMe is bool) &&
        (!('plan' in data) || data.plan in ['free', 'premium']) &&
        (!('isPremium' in data) || data.isPremium is bool) &&
        (!('profileCompleted' in data) || data.profileCompleted is bool) &&
        (!('profileVisibility' in data) || data.profileVisibility is bool) &&
        (!('visibility' in data) || isValidVisibilityMap(data.visibility)) &&
        (!('privacySettings' in data) || isValidPrivacySettings(data.privacySettings)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('isPaid' in data) || data.isPaid is bool) &&
        (!('isAdmin' in data) || data.isAdmin is bool) &&
        (!('paymentStatus' in data) || data.paymentStatus in ['none', 'pending', 'verified', 'rejected']) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80)) &&
        (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120)) &&
        (!('paymentAmount' in data) || (data.paymentAmount is string && data.paymentAmount.size() <= 80)) &&
        (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 450000)) &&
        (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 80)) &&
        (!('premiumActivatedAt' in data) || (data.premiumActivatedAt is string && data.premiumActivatedAt.size() <= 64)) &&
        (!('premiumExpiresAt' in data) || (data.premiumExpiresAt is string && data.premiumExpiresAt.size() <= 64)) &&
        (!('toolsData' in data) || data.toolsData is map);
    }

    function isValidPaymentRequest(data) {
      return data is map &&
        data.keys().hasAll(['id', 'uid', 'userName', 'paymentMethod', 'transactionId', 'status']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 80 &&
        data.transactionId is string && data.transactionId.size() >= 1 && data.transactionId.size() <= 120 &&
        data.status in ['pending', 'verified', 'rejected'] &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200)) &&
        (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 60)) &&
        (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 300)) &&
        (!('currentRole' in data) || (data.currentRole is string && data.currentRole.size() <= 200)) &&
        (!('amount' in data) || (data.amount is string && data.amount.size() <= 80)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 450000)) &&
        (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64)) &&
        (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 80)) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 64)) &&
        (!('premiumExpiresAt' in data) || (data.premiumExpiresAt is string && data.premiumExpiresAt.size() <= 64));
    }

    function isValidCertificate(data) {
      return data is map &&
        data.keys().hasAll(['id', 'certificateNumber', 'recipientName', 'trainingTitle', 'issueDate', 'verificationStatus']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.certificateNumber is string && data.certificateNumber.size() >= 1 && data.certificateNumber.size() <= 120 &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 160 &&
        data.trainingTitle is string && data.trainingTitle.size() >= 1 && data.trainingTitle.size() <= 240 &&
        data.issueDate is string && data.issueDate.size() >= 1 && data.issueDate.size() <= 64 &&
        data.verificationStatus in ['valid', 'revoked'] &&
        (!('recipientUid' in data) || (data.recipientUid is string && data.recipientUid.size() <= 128)) &&
        (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 200)) &&
        (!('trainingCategory' in data) || (data.trainingCategory is string && data.trainingCategory.size() <= 120)) &&
        (!('accreditationBody' in data) || (data.accreditationBody is string && data.accreditationBody.size() <= 160)) &&
        (!('certificateImageUrl' in data) || (data.certificateImageUrl is string && data.certificateImageUrl.size() <= 550000)) &&
        (!('issuedBy' in data) || (data.issuedBy is string && data.issuedBy.size() <= 160)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidCloudStorageConfig(data) {
      return data is map &&
        data.keys().hasAll(['provider']) &&
        data.provider in ['smart-firestore', 'cloudinary'] &&
        (!('cloudinaryCloudName' in data) || (data.cloudinaryCloudName is string && data.cloudinaryCloudName.size() <= 120)) &&
        (!('cloudinaryUploadPreset' in data) || (data.cloudinaryUploadPreset is string && data.cloudinaryUploadPreset.size() <= 120)) &&
        (!('whatsappChannelUrl' in data) || (data.whatsappChannelUrl is string && data.whatsappChannelUrl.size() <= 500)) &&
        (!('whatsappChannelButtonText' in data) || (data.whatsappChannelButtonText is string && data.whatsappChannelButtonText.size() <= 120)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidChatMessage(data) {
      return data is map &&
        data.keys().hasAll(['id', 'senderName', 'recipientName', 'chatType', 'message']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120 &&
        data.chatType in ['admin_support', 'hiring_contact'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        (!('senderUid' in data) || (data.senderUid is string && data.senderUid.size() <= 128)) &&
        (!('senderPhone' in data) || (data.senderPhone is string && data.senderPhone.size() <= 60)) &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidJob(data) {
      return data is map &&
        data.keys().hasAll(['title', 'company', 'category', 'isActive']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.company is string && data.company.size() >= 1 && data.company.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 120)) &&
        (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 120)) &&
        (!('experienceRequired' in data) || (data.experienceRequired is string && data.experienceRequired.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 8000)) &&
        (!('hrEmail' in data) || (data.hrEmail is string && data.hrEmail.size() <= 200)) &&
        (!('emailSubject' in data) || (data.emailSubject is string && data.emailSubject.size() <= 300)) &&
        (!('applicationGuidelines' in data) || (data.applicationGuidelines is string && data.applicationGuidelines.size() <= 2000)) &&
        (!('applyLink' in data) || (data.applyLink is string && data.applyLink.size() <= 500)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('postedAt' in data) || (data.postedAt is string && data.postedAt.size() <= 64)) &&
        (!('expiryAt' in data) || (data.expiryAt is string && data.expiryAt.size() <= 64));
    }

    function isValidScholarship(data) {
      return data is map &&
        data.keys().hasAll(['title', 'organization', 'country', 'isActive']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 240 &&
        data.country is string && data.country.size() >= 1 && data.country.size() <= 120 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 120)) &&
        (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 64)) &&
        (!('fundingType' in data) || (data.fundingType is string && data.fundingType.size() <= 120)) &&
        (!('degreeLevel' in data) || (data.degreeLevel is string && data.degreeLevel.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('eligibility' in data) || (data.eligibility is string && data.eligibility.size() <= 8000)) &&
        (!('hrEmail' in data) || (data.hrEmail is string && data.hrEmail.size() <= 200)) &&
        (!('emailSubject' in data) || (data.emailSubject is string && data.emailSubject.size() <= 300)) &&
        (!('applicationGuidelines' in data) || (data.applicationGuidelines is string && data.applicationGuidelines.size() <= 2000)) &&
        (!('applyLink' in data) || (data.applyLink is string && data.applyLink.size() <= 500));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mindmademedia9@gmail.com';
    }

    function isValidTraining(data) {
      return data is map &&
        data.keys().hasAll(['category', 'title', 'isActive']) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('standardCode' in data) || data.standardCode == null || (data.standardCode is string && data.standardCode.size() <= 80)) &&
        (!('subType' in data) || data.subType == null || (data.subType is string && data.subType.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('duration' in data) || (data.duration is string && data.duration.size() <= 120)) &&
        (!('fees' in data) || (data.fees is string && data.fees.size() <= 120)) &&
        (!('enrollLink' in data) || (data.enrollLink is string && data.enrollLink.size() <= 500));
    }

    // Strict Per-User Profile & Community Visibility Rules:
    // 1. Only the authenticated owner (request.auth.uid == uid) or Admin can create, update, or delete their profile.
    // 2. Other signed-in users can read the sanitized /users/{uid} profile document; frontend enforces field-level visibility ('public' | 'private' | 'premium') + viewer plan.
    // 3. Non-admin users cannot escalate their own isAdmin flag.
    match /users/{uid} {
      allow get, list: if isSignedIn();
      allow create: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidUser(request.resource.data, uid) &&
        (isAdmin() || !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidUser(request.resource.data, uid) &&
        (isAdmin() || !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow delete: if isOwner(uid) || isAdmin();

      // Strictly private per-user vault: NEVER readable or writable by any other user
      match /private/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidUser(request.resource.data, uid);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Profile subcollection (/users/{uid}/profile/{docId})
      match /profile/{docId} {
        allow get, list: if isSignedIn();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidUser(request.resource.data, uid);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Nutrition Tool Subcollections (/users/{uid}/nutritionProfile, mealPlans, foodLogs, waterLogs, healthRecommendations)
      match /nutritionProfile/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /mealPlans/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /foodLogs/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /waterLogs/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /healthRecommendations/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /examResults/{examId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(examId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /bookmarks/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /progress/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Exam Questions Collection
    match /examQuestions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(questionId);
    }

    // Community & Pre-loaded Recipes: Signed-in users can read and submit valid community recipes
    match /recipes/{recipeId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(recipeId) && request.resource.data is map &&
        request.resource.data.keys().hasAll(['id', 'title', 'category']) &&
        request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 200;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // Health Condition Recommendations Directory
    match /healthConditions/{condId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(condId);
    }

    // Payment verification requests & receipts: Strictly isolated to the submitting user and Admin
    match /paymentRequests/{requestId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        isValidId(requestId) &&
        isValidPaymentRequest(request.resource.data);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.status == resource.data.status)) &&
        isValidId(requestId) &&
        isValidPaymentRequest(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Training Certificates: Signed-in individuals can view/verify certificates; only Admin can issue, update, or delete
    match /certificates/{certificateId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(certificateId) && isValidCertificate(request.resource.data);
      allow delete: if isAdmin() && isValidId(certificateId);
    }

    // Cloud Storage & CDN Settings: Signed-in users can read upload configuration; only Admin can update
    match /settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(settingId) && isValidCloudStorageConfig(request.resource.data);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Direct support & hiring chats: Strictly isolated to the message sender and Admin
    match /chats/{chatId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        isValidId(chatId) &&
        isValidChatMessage(request.resource.data);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid && isValidChatMessage(request.resource.data));
    }

    // Jobs, Scholarships & Trainings: Authenticated members can view; only Admin can publish/modify/delete
    match /jobs/{jobId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(jobId) && isValidJob(request.resource.data);
      allow delete: if isAdmin() && isValidId(jobId);
    }

    match /scholarships/{scholarshipId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(scholarshipId) && isValidScholarship(request.resource.data);
      allow delete: if isAdmin() && isValidId(scholarshipId);
    }

    match /trainings/{trainingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isAdmin() && isValidId(trainingId) && isValidTraining(request.resource.data);
      allow delete: if isAdmin() && isValidId(trainingId);
    }
  }
}


