rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow get: if true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPrivacySettings(ps) {
      return ps is map &&
        ps.keys().hasAll([
          'qualification_public',
          'experience_public',
          'currentRole_public',
          'location_public',
          'email_public',
          'phone_public'
        ]) &&
        ps.qualification_public is bool &&
        ps.experience_public is bool &&
        ps.currentRole_public is bool &&
        ps.location_public is bool &&
        ps.email_public is bool &&
        ps.phone_public is bool &&
        (!('hireMe_public' in ps) || ps.hireMe_public is bool);
    }

    function isValidVisibilityMap(vis) {
      return vis is map;
    }

    function isValidUser(data, uid) {
      return data is map &&
        data.keys().hasAll(['uid', 'name']) &&
        data.uid == uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
        (!('profilePhotoUrl' in data) || (data.profilePhotoUrl is string && data.profilePhotoUrl.size() <= 350000)) &&
        (!('profilePicUrl' in data) || (data.profilePicUrl is string && data.profilePicUrl.size() <= 350000)) &&
        (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 300)) &&
        (!('experience' in data) || (data.experience is string && data.experience.size() <= 5000) || (data.experience is list && data.experience.size() <= 50)) &&
        (!('experienceItems' in data) || (data.experienceItems is list && data.experienceItems.size() <= 50)) &&
        (!('education' in data) || (data.education is list && data.education.size() <= 50)) &&
        (!('certifications' in data) || (data.certifications is list && data.certifications.size() <= 50)) &&
        (!('projects' in data) || (data.projects is list && data.projects.size() <= 50)) &&
        (!('currentRole' in data) || (data.currentRole is string && data.currentRole.size() <= 200)) &&
        (!('company' in data) || (data.company is string && data.company.size() <= 200)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 120)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 60)) &&
        (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 500)) &&
        (!('portfolioUrl' in data) || (data.portfolioUrl is string && data.portfolioUrl.size() <= 500)) &&
        (!('skills' in data) || (data.skills is list && data.skills.size() <= 30)) &&
        (!('specializations' in data) || (data.specializations is list && data.specializations.size() <= 30)) &&
        (!('cvUrl' in data) || (data.cvUrl is string && data.cvUrl.size() <= 750000)) &&
        (!('cvFileName' in data) || (data.cvFileName is string && data.cvFileName.size() <= 260)) &&
        (!('cvFileSize' in data) || (data.cvFileSize is string && data.cvFileSize.size() <= 60)) &&
        (!('cvUploadedAt' in data) || (data.cvUploadedAt is string && data.cvUploadedAt.size() <= 64)) &&
        (!('hireMe' in data) || data.hireMe is bool) &&
        (!('plan' in data) || data.plan in ['free', 'premium']) &&
        (!('isPremium' in data) || data.isPremium is bool) &&
        (!('profileCompleted' in data) || data.profileCompleted is bool) &&
        (!('profileVisibility' in data) || data.profileVisibility is bool) &&
        (!('visibility' in data) || isValidVisibilityMap(data.visibility)) &&
        (!('privacySettings' in data) || isValidPrivacySettings(data.privacySettings)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('isPaid' in data) || data.isPaid is bool) &&
        (!('isAdmin' in data) || data.isAdmin is bool) &&
        (!('paymentStatus' in data) || data.paymentStatus in ['none', 'pending', 'verified', 'rejected']) &&
        (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80)) &&
        (!('paymentReference' in data) || (data.paymentReference is string && data.paymentReference.size() <= 120)) &&
        (!('paymentAmount' in data) || (data.paymentAmount is string && data.paymentAmount.size() <= 80)) &&
        (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 450000)) &&
        (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 80)) &&
        (!('premiumActivatedAt' in data) || (data.premiumActivatedAt is string && data.premiumActivatedAt.size() <= 64)) &&
        (!('premiumExpiresAt' in data) || (data.premiumExpiresAt is string && data.premiumExpiresAt.size() <= 64)) &&
        (!('toolsData' in data) || data.toolsData is map);
    }

    function isValidPaymentRequest(data) {
      return data is map &&
        data.keys().hasAll(['id', 'uid', 'userName', 'paymentMethod', 'transactionId', 'status']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 80 &&
        data.transactionId is string && data.transactionId.size() >= 1 && data.transactionId.size() <= 120 &&
        data.status in ['pending', 'verified', 'rejected'] &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200)) &&
        (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 60)) &&
        (!('qualification' in data) || (data.qualification is string && data.qualification.size() <= 300)) &&
        (!('currentRole' in data) || (data.currentRole is string && data.currentRole.size() <= 200)) &&
        (!('amount' in data) || (data.amount is string && data.amount.size() <= 80)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 450000)) &&
        (!('submittedAt' in data) || (data.submittedAt is string && data.submittedAt.size() <= 64)) &&
        (!('subscriptionPlan' in data) || (data.subscriptionPlan is string && data.subscriptionPlan.size() <= 80)) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 64)) &&
        (!('premiumExpiresAt' in data) || (data.premiumExpiresAt is string && data.premiumExpiresAt.size() <= 64));
    }

    function isValidCertificate(data) {
      return data is map &&
        data.keys().hasAll(['id', 'certificateNumber', 'recipientName', 'trainingTitle', 'issueDate', 'verificationStatus']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.certificateNumber is string && data.certificateNumber.size() >= 1 && data.certificateNumber.size() <= 120 &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 200 &&
        data.trainingTitle is string && data.trainingTitle.size() >= 1 && data.trainingTitle.size() <= 300 &&
        data.issueDate is string && data.issueDate.size() >= 1 && data.issueDate.size() <= 80 &&
        data.verificationStatus in ['valid', 'revoked'] &&
        (!('recipientUid' in data) || (data.recipientUid is string && data.recipientUid.size() <= 128)) &&
        (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 200)) &&
        (!('courseId' in data) || (data.courseId is string && data.courseId.size() <= 128)) &&
        (!('trainingCategory' in data) || (data.trainingCategory is string && data.trainingCategory.size() <= 120)) &&
        (!('accreditationBody' in data) || (data.accreditationBody is string && data.accreditationBody.size() <= 200)) &&
        (!('certificateImageUrl' in data) || (data.certificateImageUrl is string && data.certificateImageUrl.size() <= 550000)) &&
        (!('issuedBy' in data) || (data.issuedBy is string && data.issuedBy.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('scorePercentage' in data) || (data.scorePercentage is number && data.scorePercentage >= 0 && data.scorePercentage <= 100)) &&
        (!('distinction' in data) || data.distinction is bool);
    }

    function isValidCloudStorageConfig(data) {
      return data is map &&
        data.keys().hasAll(['provider']) &&
        data.provider in ['smart-firestore', 'cloudinary'] &&
        (!('cloudinaryCloudName' in data) || (data.cloudinaryCloudName is string && data.cloudinaryCloudName.size() <= 120)) &&
        (!('cloudinaryUploadPreset' in data) || (data.cloudinaryUploadPreset is string && data.cloudinaryUploadPreset.size() <= 120)) &&
        (!('whatsappChannelUrl' in data) || (data.whatsappChannelUrl is string && data.whatsappChannelUrl.size() <= 500)) &&
        (!('whatsappChannelButtonText' in data) || (data.whatsappChannelButtonText is string && data.whatsappChannelButtonText.size() <= 120)) &&
        (!('paymentGateway' in data) || data.paymentGateway is map) &&
        (!('customAds' in data) || (data.customAds is list && data.customAds.size() <= 50)) &&
        (!('frontPageConfig' in data) || data.frontPageConfig is map) &&
        (!('manualRevenueEntries' in data) || (data.manualRevenueEntries is list && data.manualRevenueEntries.size() <= 500)) &&
        (!('customTrainings' in data) || (data.customTrainings is list && data.customTrainings.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidCustomTrainingRegistration(data) {
      return data is map &&
        data.keys().hasAll([
          'id',
          'trainingId',
          'trainingTitle',
          'trainingFee',
          'name',
          'fatherName',
          'education',
          'designation',
          'dob',
          'email',
          'mobileNo',
          'status',
          'submittedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.trainingId is string && data.trainingId.size() >= 1 && data.trainingId.size() <= 128 &&
        data.trainingTitle is string && data.trainingTitle.size() >= 1 && data.trainingTitle.size() <= 240 &&
        data.trainingFee is string && data.trainingFee.size() >= 1 && data.trainingFee.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.fatherName is string && data.fatherName.size() >= 1 && data.fatherName.size() <= 140 &&
        data.education is string && data.education.size() >= 1 && data.education.size() <= 200 &&
        data.designation is string && data.designation.size() >= 1 && data.designation.size() <= 200 &&
        data.dob is string && data.dob.size() >= 1 && data.dob.size() <= 64 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.mobileNo is string && data.mobileNo.size() >= 4 && data.mobileNo.size() <= 60 &&
        data.status in ['pending', 'contacted', 'enrolled', 'archived'] &&
        data.submittedAt is string && data.submittedAt.size() >= 1 && data.submittedAt.size() <= 64 &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128));
    }

    function isValidChatMessage(data) {
      return data is map &&
        data.keys().hasAll(['id', 'senderName', 'recipientName', 'chatType', 'message']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 120 &&
        data.chatType in ['admin_support', 'hiring_contact'] &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        (!('senderUid' in data) || (data.senderUid is string && data.senderUid.size() <= 128)) &&
        (!('senderPhone' in data) || (data.senderPhone is string && data.senderPhone.size() <= 60)) &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 2000)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidJob(data) {
      return data is map &&
        data.keys().hasAll(['title', 'company', 'category', 'isActive']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.company is string && data.company.size() >= 1 && data.company.size() <= 200 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('country' in data) || (data.country is string && data.country.size() <= 120)) &&
        (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 120)) &&
        (!('experienceRequired' in data) || (data.experienceRequired is string && data.experienceRequired.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('requirements' in data) || (data.requirements is string && data.requirements.size() <= 8000)) &&
        (!('hrEmail' in data) || (data.hrEmail is string && data.hrEmail.size() <= 200)) &&
        (!('emailSubject' in data) || (data.emailSubject is string && data.emailSubject.size() <= 300)) &&
        (!('applicationGuidelines' in data) || (data.applicationGuidelines is string && data.applicationGuidelines.size() <= 2000)) &&
        (!('applyLink' in data) || (data.applyLink is string && data.applyLink.size() <= 500)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
        (!('postedAt' in data) || (data.postedAt is string && data.postedAt.size() <= 64)) &&
        (!('expiryAt' in data) || (data.expiryAt is string && data.expiryAt.size() <= 64));
    }

    function isValidScholarship(data) {
      return data is map &&
        data.keys().hasAll(['title', 'organization', 'country', 'isActive']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.organization is string && data.organization.size() >= 1 && data.organization.size() <= 240 &&
        data.country is string && data.country.size() >= 1 && data.country.size() <= 120 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 120)) &&
        (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 64)) &&
        (!('fundingType' in data) || (data.fundingType is string && data.fundingType.size() <= 120)) &&
        (!('degreeLevel' in data) || (data.degreeLevel is string && data.degreeLevel.size() <= 120)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('eligibility' in data) || (data.eligibility is string && data.eligibility.size() <= 8000)) &&
        (!('hrEmail' in data) || (data.hrEmail is string && data.hrEmail.size() <= 200)) &&
        (!('emailSubject' in data) || (data.emailSubject is string && data.emailSubject.size() <= 300)) &&
        (!('applicationGuidelines' in data) || (data.applicationGuidelines is string && data.applicationGuidelines.size() <= 2000)) &&
        (!('applyLink' in data) || (data.applyLink is string && data.applyLink.size() <= 500));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'mindmademedia9@gmail.com';
    }

    function isValidTraining(data) {
      return data is map &&
        data.keys().hasAll(['category', 'title', 'isActive']) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.isActive is bool &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('standardCode' in data) || data.standardCode == null || (data.standardCode is string && data.standardCode.size() <= 80)) &&
        (!('accreditationStandard' in data) || data.accreditationStandard == null || (data.accreditationStandard is string && data.accreditationStandard.size() <= 200)) &&
        (!('certificateFeeRs' in data) || data.certificateFeeRs == null || (data.certificateFeeRs is number && data.certificateFeeRs >= 0 && data.certificateFeeRs <= 1000000)) &&
        (!('subType' in data) || data.subType == null || (data.subType is string && data.subType.size() <= 80)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 8000)) &&
        (!('duration' in data) || (data.duration is string && data.duration.size() <= 120)) &&
        (!('fees' in data) || (data.fees is string && data.fees.size() <= 120)) &&
        (!('enrollLink' in data) || (data.enrollLink is string && data.enrollLink.size() <= 500)) &&
        (!('customModules' in data) || (data.customModules is list && data.customModules.size() <= 60)) &&
        (!('customMcqs' in data) || (data.customMcqs is list && data.customMcqs.size() <= 200));
    }

    function existingComplaintCount(data) {
      return ('complaintsCount' in data && data.complaintsCount is number)
        ? data.complaintsCount
        : 0;
    }

    function isOrgOwnerPaid(orgId) {
      return exists(/databases/$(database)/documents/users/$(orgId)) &&
        (
          ('isAdmin' in get(/databases/$(database)/documents/users/$(orgId)).data &&
            get(/databases/$(database)/documents/users/$(orgId)).data.isAdmin == true) ||
          ('isPaid' in get(/databases/$(database)/documents/users/$(orgId)).data &&
            get(/databases/$(database)/documents/users/$(orgId)).data.isPaid == true) ||
          ('isPremium' in get(/databases/$(database)/documents/users/$(orgId)).data &&
            get(/databases/$(database)/documents/users/$(orgId)).data.isPremium == true) ||
          ('plan' in get(/databases/$(database)/documents/users/$(orgId)).data &&
            get(/databases/$(database)/documents/users/$(orgId)).data.plan == 'premium')
        );
    }

    function canOrgAcceptMoreComplaints(orgId) {
      return isAdmin() ||
        isOrgOwnerPaid(orgId) ||
        existingComplaintCount(get(/databases/$(database)/documents/complaintOrgs/$(orgId)).data) < 10;
    }

    function isValidComplaintOrg(data, orgId) {
      return data is map &&
        data.keys().hasAll([
          'orgId',
          'ownerUid',
          'companyName',
          'organizationType',
          'isActive',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orgId',
          'ownerUid',
          'companyName',
          'organizationType',
          'logoUrl',
          'branchLocation',
          'contactPhone',
          'contactEmail',
          'welcomeNote',
          'categories',
          'complaintsCount',
          'lastComplaintId',
          'isActive',
          'createdAt',
          'updatedAt'
        ]) &&
        data.orgId == orgId &&
        data.ownerUid == orgId &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160 &&
        data.organizationType is string && data.organizationType.size() >= 1 && data.organizationType.size() <= 100 &&
        data.isActive is bool &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64 &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 450000)) &&
        (!('branchLocation' in data) || (data.branchLocation is string && data.branchLocation.size() <= 240)) &&
        (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 60)) &&
        (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 200)) &&
        (!('welcomeNote' in data) || (data.welcomeNote is string && data.welcomeNote.size() <= 600)) &&
        (!('categories' in data) || (data.categories is list && data.categories.size() <= 20 && (data.categories.size() == 0 || data.categories[0] is string))) &&
        (!('complaintsCount' in data) || (data.complaintsCount is number && data.complaintsCount >= 0 && data.complaintsCount <= 1000000)) &&
        (!('lastComplaintId' in data) || isValidId(data.lastComplaintId));
    }

    function isValidPublicComplaintCreate(data, orgId, complaintId) {
      return data is map &&
        data.keys().hasAll([
          'id',
          'orgId',
          'complaintCode',
          'companyNameSnapshot',
          'complainantName',
          'category',
          'severity',
          'subject',
          'description',
          'status',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'orgId',
          'complaintCode',
          'companyNameSnapshot',
          'complainantName',
          'complainantPhone',
          'complainantEmail',
          'category',
          'severity',
          'subject',
          'description',
          'batchOrOrderRef',
          'incidentDate',
          'evidencePhotoUrl',
          'status',
          'createdAt'
        ]) &&
        data.id == complaintId &&
        data.orgId == orgId &&
        data.status == 'open' &&
        data.complaintCode is string && data.complaintCode.size() >= 3 && data.complaintCode.size() <= 64 &&
        data.companyNameSnapshot is string && data.companyNameSnapshot.size() >= 1 && data.companyNameSnapshot.size() <= 160 &&
        data.complainantName is string && data.complainantName.size() >= 1 && data.complainantName.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.severity in ['low', 'medium', 'high', 'critical'] &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        (!('complainantPhone' in data) || (data.complainantPhone is string && data.complainantPhone.size() <= 60)) &&
        (!('complainantEmail' in data) || (data.complainantEmail is string && data.complainantEmail.size() <= 200)) &&
        (!('batchOrOrderRef' in data) || (data.batchOrOrderRef is string && data.batchOrOrderRef.size() <= 120)) &&
        (!('incidentDate' in data) || (data.incidentDate is string && data.incidentDate.size() <= 64)) &&
        (!('evidencePhotoUrl' in data) || (data.evidencePhotoUrl is string && data.evidencePhotoUrl.size() <= 450000));
    }

    function isValidOwnerComplaint(data, orgId, complaintId) {
      return data is map &&
        data.keys().hasAll([
          'id',
          'orgId',
          'complaintCode',
          'companyNameSnapshot',
          'complainantName',
          'category',
          'severity',
          'subject',
          'description',
          'status',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'orgId',
          'complaintCode',
          'companyNameSnapshot',
          'complainantName',
          'complainantPhone',
          'complainantEmail',
          'category',
          'severity',
          'subject',
          'description',
          'batchOrOrderRef',
          'incidentDate',
          'evidencePhotoUrl',
          'status',
          'rootCauseCategory',
          'rootCause',
          'correction',
          'correctiveAction',
          'assignedTo',
          'targetClosureDate',
          'verificationNotes',
          'closedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == complaintId &&
        data.orgId == orgId &&
        data.status in ['open', 'in_progress', 'closed'] &&
        data.complaintCode is string && data.complaintCode.size() >= 3 && data.complaintCode.size() <= 64 &&
        data.companyNameSnapshot is string && data.companyNameSnapshot.size() >= 1 && data.companyNameSnapshot.size() <= 160 &&
        data.complainantName is string && data.complainantName.size() >= 1 && data.complainantName.size() <= 120 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.severity in ['low', 'medium', 'high', 'critical'] &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        (!('complainantPhone' in data) || (data.complainantPhone is string && data.complainantPhone.size() <= 60)) &&
        (!('complainantEmail' in data) || (data.complainantEmail is string && data.complainantEmail.size() <= 200)) &&
        (!('batchOrOrderRef' in data) || (data.batchOrOrderRef is string && data.batchOrOrderRef.size() <= 120)) &&
        (!('incidentDate' in data) || (data.incidentDate is string && data.incidentDate.size() <= 64)) &&
        (!('evidencePhotoUrl' in data) || (data.evidencePhotoUrl is string && data.evidencePhotoUrl.size() <= 450000)) &&
        (!('rootCauseCategory' in data) || (data.rootCauseCategory is string && data.rootCauseCategory.size() <= 120)) &&
        (!('rootCause' in data) || (data.rootCause is string && data.rootCause.size() <= 4000)) &&
        (!('correction' in data) || (data.correction is string && data.correction.size() <= 4000)) &&
        (!('correctiveAction' in data) || (data.correctiveAction is string && data.correctiveAction.size() <= 4000)) &&
        (!('assignedTo' in data) || (data.assignedTo is string && data.assignedTo.size() <= 120)) &&
        (!('targetClosureDate' in data) || (data.targetClosureDate is string && data.targetClosureDate.size() <= 64)) &&
        (!('verificationNotes' in data) || (data.verificationNotes is string && data.verificationNotes.size() <= 2000)) &&
        (!('closedAt' in data) || (data.closedAt is string && data.closedAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidQaWorkspace(data, uid) {
      return data is map &&
        data.keys().hasAll(['uid', 'ownerUid', 'companyName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'ownerUid',
          'companyName',
          'industryType',
          'facilityAddress',
          'scopeStatement',
          'standards',
          'docCodePrefix',
          'pfaOrRegNo',
          'contactPhone',
          'contactEmail',
          'logoUrl',
          'preparedBy',
          'preparedRole',
          'reviewedBy',
          'reviewedRole',
          'approvedBy',
          'approvedRole',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid == uid &&
        data.ownerUid == uid &&
        data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64 &&
        (!('industryType' in data) || (data.industryType is string && data.industryType.size() <= 120)) &&
        (!('facilityAddress' in data) || (data.facilityAddress is string && data.facilityAddress.size() <= 300)) &&
        (!('scopeStatement' in data) || (data.scopeStatement is string && data.scopeStatement.size() <= 1200)) &&
        (!('standards' in data) || (data.standards is list && data.standards.size() <= 12 && (data.standards.size() == 0 || data.standards[0] is string))) &&
        (!('docCodePrefix' in data) || (data.docCodePrefix is string && data.docCodePrefix.size() <= 24)) &&
        (!('pfaOrRegNo' in data) || (data.pfaOrRegNo is string && data.pfaOrRegNo.size() <= 120)) &&
        (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() <= 60)) &&
        (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 200)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 450000)) &&
        (!('preparedBy' in data) || (data.preparedBy is string && data.preparedBy.size() <= 120)) &&
        (!('preparedRole' in data) || (data.preparedRole is string && data.preparedRole.size() <= 120)) &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 120)) &&
        (!('reviewedRole' in data) || (data.reviewedRole is string && data.reviewedRole.size() <= 120)) &&
        (!('approvedBy' in data) || (data.approvedBy is string && data.approvedBy.size() <= 120)) &&
        (!('approvedRole' in data) || (data.approvedRole is string && data.approvedRole.size() <= 120));
    }

    function isValidQaModule(data, uid, moduleId) {
      return data is map &&
        data.keys().hasAll(['moduleId', 'ownerUid', 'meta', 'payload']) &&
        data.keys().hasOnly(['moduleId', 'ownerUid', 'meta', 'payload']) &&
        data.moduleId == moduleId &&
        data.ownerUid == uid &&
        data.meta is map &&
        data.meta.keys().hasAll(['docCode', 'revision', 'status', 'effectiveDate', 'updatedAt']) &&
        data.meta.docCode is string && data.meta.docCode.size() >= 1 && data.meta.docCode.size() <= 64 &&
        data.meta.revision is string && data.meta.revision.size() >= 1 && data.meta.revision.size() <= 32 &&
        data.meta.status in ['draft', 'in_review', 'approved'] &&
        data.meta.effectiveDate is string && data.meta.effectiveDate.size() >= 1 && data.meta.effectiveDate.size() <= 64 &&
        data.meta.updatedAt is string && data.meta.updatedAt.size() >= 1 && data.meta.updatedAt.size() <= 64 &&
        data.payload is map;
    }

    function isValidSupportTicket(data, ticketId) {
      return data is map &&
        data.keys().hasAll([
          'id',
          'uid',
          'isGuest',
          'userName',
          'userPlan',
          'requestType',
          'pageContext',
          'subject',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'uid',
          'isGuest',
          'userName',
          'userEmail',
          'userPhone',
          'userPlan',
          'requestType',
          'pageContext',
          'subject',
          'message',
          'rating',
          'chatTranscript',
          'status',
          'adminReply',
          'adminRepliedAt',
          'userFollowUp',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == ticketId &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.isGuest is bool &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 200)) &&
        (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 60)) &&
        data.userPlan in ['guest', 'free', 'paid'] &&
        data.requestType in ['issue_report', 'custom_opinion', 'admin_chat'] &&
        data.pageContext is string && data.pageContext.size() >= 1 && data.pageContext.size() <= 160 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 200 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 3000 &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        (!('chatTranscript' in data) || (data.chatTranscript is list && data.chatTranscript.size() <= 30 && (data.chatTranscript.size() == 0 || data.chatTranscript[0] is map))) &&
        data.status in ['open', 'in_review', 'resolved'] &&
        (!('adminReply' in data) || (data.adminReply is string && data.adminReply.size() <= 3000)) &&
        (!('adminRepliedAt' in data) || (data.adminRepliedAt is string && data.adminRepliedAt.size() <= 64)) &&
        (!('userFollowUp' in data) || (data.userFollowUp is string && data.userFollowUp.size() <= 2000)) &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Strict Per-User Profile & Community Visibility Rules:
    // 1. Only the authenticated owner (request.auth.uid == uid) or Admin can create, update, or delete their profile.
    // 2. Public visitors and signed-in users can read the sanitized /users/{uid} profile document; private PII is isolated in /users/{uid}/private/{docId}.
    // 3. Non-admin users cannot escalate their own isAdmin flag.
    match /users/{uid} {
      allow get, list: if true;
      allow create: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidUser(request.resource.data, uid) &&
        (isAdmin() || !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidUser(request.resource.data, uid) &&
        (isAdmin() || !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow delete: if isOwner(uid) || isAdmin();

      // Strictly private per-user vault: NEVER readable or writable by any other user
      match /private/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidUser(request.resource.data, uid);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Sanitized profile subcollection (/users/{uid}/profile/{docId})
      match /profile/{docId} {
        allow get, list: if true;
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidUser(request.resource.data, uid);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Nutrition Tool Subcollections (/users/{uid}/nutritionProfile, mealPlans, foodLogs, waterLogs, healthRecommendations)
      match /nutritionProfile/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /mealPlans/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /foodLogs/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /waterLogs/{dateId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(dateId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /healthRecommendations/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /examResults/{examId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(examId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /bookmarks/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /progress/{docId} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) && isValidId(docId) && request.resource.data is map;
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Exam Questions Collection
    match /examQuestions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(questionId);
    }

    // Community & Pre-loaded Recipes: Publicly readable; signed-in users can submit valid community recipes
    match /recipes/{recipeId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(recipeId) && request.resource.data is map &&
        request.resource.data.keys().hasAll(['id', 'title', 'category']) &&
        request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 200;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // Health Condition Recommendations Directory
    match /healthConditions/{condId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(condId);
    }

    // Payment verification requests & receipts: Strictly isolated to the submitting user and Admin
    match /paymentRequests/{requestId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        (isAdmin() || request.resource.data.uid == request.auth.uid) &&
        isValidId(requestId) &&
        isValidPaymentRequest(request.resource.data);
      allow update: if (isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.status == resource.data.status)) &&
        isValidId(requestId) &&
        isValidPaymentRequest(request.resource.data);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Training Certificates: Publicly verifiable via QR code / Certificate ID; only Admin can issue, update, or delete
    match /certificates/{certificateId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(certificateId) && isValidCertificate(request.resource.data);
      allow delete: if isAdmin() && isValidId(certificateId);
    }

    // Cloud Storage & CDN Settings: Publicly readable for payment gateway & WhatsApp channel links; only Admin can update
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(settingId) && isValidCloudStorageConfig(request.resource.data);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Direct support & hiring chats: Strictly isolated to the message sender and Admin
    match /chats/{chatId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        isValidId(chatId) &&
        isValidChatMessage(request.resource.data);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.senderUid == request.auth.uid && isValidChatMessage(request.resource.data));
    }

    // Jobs, Scholarships & Trainings: Publicly viewable by all visitors; only Admin can publish/modify/delete
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(jobId) && isValidJob(request.resource.data);
      allow delete: if isAdmin() && isValidId(jobId);
    }

    match /scholarships/{scholarshipId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(scholarshipId) && isValidScholarship(request.resource.data);
      allow delete: if isAdmin() && isValidId(scholarshipId);
    }

    match /trainings/{trainingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(trainingId) && isValidTraining(request.resource.data);
      allow delete: if isAdmin() && isValidId(trainingId);
    }

    // Custom Training Registrations: Any visitor or user can submit a valid registration; only Admin can read, update, or delete
    match /customTrainingRegistrations/{regId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(regId) && isValidCustomTrainingRegistration(request.resource.data);
      allow update: if isAdmin() && isValidId(regId) && isValidCustomTrainingRegistration(request.resource.data);
      allow delete: if isAdmin() && isValidId(regId);
    }

    // Per-User QR Complaint Handling & CAPA Directory
    // - Anyone scanning a QR code can read that specific org's public branding (/complaintOrgs/{orgId})
    //   and submit up to 10 'open' complaints for Free/Guest accounts, or unlimited for Paid users.
    // - Listing, reading, updating CAPA/status, or deleting complaints is STRICTLY isolated to the org owner (orgId == request.auth.uid) or Admin.
    match /complaintOrgs/{orgId} {
      allow get: if isValidId(orgId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if (isOwner(orgId) || isAdmin()) &&
        isValidId(orgId) &&
        isValidComplaintOrg(request.resource.data, orgId) &&
        existingComplaintCount(request.resource.data) == 0;
      allow update: if isValidId(orgId) &&
        isValidComplaintOrg(request.resource.data, orgId) &&
        (
          (
            (isOwner(orgId) || isAdmin()) &&
            request.resource.data.createdAt == resource.data.createdAt &&
            (
              isAdmin() ||
              isOrgOwnerPaid(orgId) ||
              (
                existingComplaintCount(request.resource.data) >= existingComplaintCount(resource.data) &&
                existingComplaintCount(request.resource.data) <= 10
              )
            )
          ) ||
          (
            resource.data.isActive == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complaintsCount', 'lastComplaintId', 'updatedAt']) &&
            ('complaintsCount' in request.resource.data) &&
            request.resource.data.complaintsCount == existingComplaintCount(resource.data) + 1 &&
            ('lastComplaintId' in request.resource.data) &&
            isValidId(request.resource.data.lastComplaintId) &&
            existsAfter(/databases/$(database)/documents/complaintOrgs/$(orgId)/complaints/$(request.resource.data.lastComplaintId)) &&
            (existingComplaintCount(resource.data) < 10 || isOrgOwnerPaid(orgId))
          )
        );
      allow delete: if (isOwner(orgId) || isAdmin()) && isValidId(orgId);

      match /complaints/{complaintId} {
        allow get: if isValidId(orgId) && isValidId(complaintId) && (isOwner(orgId) || isAdmin());
        allow list: if isOwner(orgId) || isAdmin();
        allow create: if isValidId(orgId) &&
          isValidId(complaintId) &&
          exists(/databases/$(database)/documents/complaintOrgs/$(orgId)) &&
          canOrgAcceptMoreComplaints(orgId) &&
          (
            ((isOwner(orgId) || isAdmin()) && isValidOwnerComplaint(request.resource.data, orgId, complaintId)) ||
            (get(/databases/$(database)/documents/complaintOrgs/$(orgId)).data.isActive == true &&
              isValidPublicComplaintCreate(request.resource.data, orgId, complaintId))
          );
        allow update: if (isOwner(orgId) || isAdmin()) &&
          isValidId(orgId) &&
          isValidId(complaintId) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          isValidOwnerComplaint(request.resource.data, orgId, complaintId) &&
          (
            isAdmin() ||
            isOrgOwnerPaid(orgId) ||
            existingComplaintCount(get(/databases/$(database)/documents/complaintOrgs/$(orgId)).data) <= 10
          );
        allow delete: if (isOwner(orgId) || isAdmin()) && isValidId(orgId) && isValidId(complaintId);
      }
    }

    // Per-User ISO 9001, FSSC 22000 & Codex HACCP Document Vault Workspace
    // Strictly isolated to the workspace owner (uid == request.auth.uid) or Admin.
    match /qaDocumentWorkspaces/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidQaWorkspace(request.resource.data, uid);
      allow update: if (isOwner(uid) || isAdmin()) &&
        isValidId(uid) &&
        isValidQaWorkspace(request.resource.data, uid) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if (isOwner(uid) || isAdmin()) && isValidId(uid);

      match /modules/{moduleId} {
        allow get: if isValidId(uid) && isValidId(moduleId) && (isOwner(uid) || isAdmin());
        allow list: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) || isAdmin()) &&
          isValidId(uid) &&
          isValidId(moduleId) &&
          exists(/databases/$(database)/documents/qaDocumentWorkspaces/$(uid)) &&
          isValidQaModule(request.resource.data, uid, moduleId);
        allow update: if (isOwner(uid) || isAdmin()) &&
          isValidId(uid) &&
          isValidId(moduleId) &&
          exists(/databases/$(database)/documents/qaDocumentWorkspaces/$(uid)) &&
          isValidQaModule(request.resource.data, uid, moduleId) &&
          request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if (isOwner(uid) || isAdmin()) && isValidId(uid) && isValidId(moduleId);
      }
    }

    // AI Support Escalations, Issue Highlights & Custom User Opinions
    // - Signed-in users can read/list ONLY their own tickets and add follow-ups until resolved.
    // - Guests can submit valid open requests (strictly without adminReply), readable ONLY by Admin (preventing any PII leak).
    // - Admin can list, review, reply to, resolve, or delete any ticket inside Admin Control Panel.
    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(ticketId) &&
        isValidSupportTicket(request.resource.data, ticketId) &&
        request.resource.data.status == 'open' &&
        !('adminReply' in request.resource.data) &&
        (
          (isSignedIn() &&
            request.resource.data.isGuest == false &&
            request.resource.data.uid == request.auth.uid) ||
          (!isSignedIn() &&
            request.resource.data.isGuest == true &&
            request.resource.data.uid.matches('^guest_[a-zA-Z0-9_\\-]+$'))
        );
      allow update: if isValidId(ticketId) &&
        isValidSupportTicket(request.resource.data, ticketId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          isAdmin() ||
          (isSignedIn() &&
            resource.data.uid == request.auth.uid &&
            resource.data.status != 'resolved' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userFollowUp', 'message', 'updatedAt']))
        );
      allow delete: if isValidId(ticketId) && (isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid));
    }
  }
}


